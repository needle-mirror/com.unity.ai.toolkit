<UXML xmlns="UnityEngine.UIElements" xmlns:toolkit="Unity.AI.Toolkit.Accounts.Components">
    <Style src="./AIDropdown.uss" />
    <Style src="../AIDropdownRoot/AIDropdownRoot.uss" />
    <toolkit:SessionStatusBanner name="banner"/>
    <toolkit:Points name="points"/>
    <VisualElement name="manage-account-group" class="section-container">
        <VisualElement class="dropdown-item-with-margin aligned-row text-menu-item">
            <Label name="manage-account" class="label-button link" text="Manage account"/>
            <Label name="data-sharing"/>
        </VisualElement>
        <Label name="check-updates" class="label-button link text-menu-item" text="Check for updates"/>
    </VisualElement>

    <VisualElement name="manage-account-separator" class="separator hidden"/>

    <VisualElement name="menu-extensions"/>
</UXML>
